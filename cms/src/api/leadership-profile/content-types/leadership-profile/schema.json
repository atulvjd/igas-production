{
  "kind": "collectionType",
  "collectionName": "leadership_profiles",
  "info": { "singularName": "leadership-profile", "pluralName": "leadership-profiles", "displayName": "Leadership profile" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "position": { "type": "string", "required": true },
    "biography": { "type": "blocks" },
    "profileImage": { "type": "component", "repeatable": false, "component": "shared.media" },
    "email": { "type": "email" },
    "linkedInUrl": { "type": "string" },
    "relatedServices": { "type": "relation", "relation": "manyToMany", "target": "api::service.service" },
    "relatedIndustries": { "type": "relation", "relation": "manyToMany", "target": "api::industry.industry" },
    "sortOrder": { "type": "integer", "default": 0 },
    "mode": { "type": "enumeration", "enum": ["india", "global"], "default": "india" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}