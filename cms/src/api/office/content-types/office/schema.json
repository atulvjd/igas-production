{
  "kind": "collectionType",
  "collectionName": "offices",
  "info": { "singularName": "office", "pluralName": "offices", "displayName": "Office" },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "city": { "type": "string", "required": true },
    "country": { "type": "string", "required": true },
    "address": { "type": "text" },
    "phone": { "type": "string" },
    "email": { "type": "email" },
    "description": { "type": "blocks" },
    "image": { "type": "component", "repeatable": false, "component": "shared.media" },
    "imageUrl": { "type": "string" },
    "imageAlt": { "type": "string" },
    "latitude": { "type": "decimal" },
    "longitude": { "type": "decimal" },
    "services": { "type": "relation", "relation": "manyToMany", "target": "api::service.service" },
    "mode": { "type": "enumeration", "enum": ["india", "global"], "default": "india" },
    "sortOrder": { "type": "integer", "default": 0 },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}