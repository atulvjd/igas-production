{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "imageUrl": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "featuredImage": { "type": "component", "repeatable": false, "component": "shared.media" },
    "contentType": { "type": "enumeration", "enum": ["news", "blog", "story", "insight"], "default": "insight" },
    "author": { "type": "string" },
    "publicationDate": { "type": "date" },
    "featured": { "type": "boolean", "default": false },
    "relatedArticles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article" },
    "relatedServices": { "type": "relation", "relation": "manyToMany", "target": "api::service.service" },
    "relatedIndustries": { "type": "relation", "relation": "manyToMany", "target": "api::industry.industry" },
    "mode": { "type": "enumeration", "enum": ["india", "global"], "default": "india" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" },
    "content": {
      "type": "blocks"
    }
  }
}
