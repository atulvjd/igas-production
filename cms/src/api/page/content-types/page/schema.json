{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "path": { "type": "string", "required": true },
    "mode": { "type": "enumeration", "enum": ["india", "global"], "required": true, "default": "india" },
    "title": { "type": "string", "required": true },
    "description": { "type": "text" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "shared.hero",
        "shared.rich-text",
        "shared.image-text",
        "shared.stats",
        "shared.carousel",
        "shared.cta",
        "shared.contact-form"
      ]
    }
  }
}