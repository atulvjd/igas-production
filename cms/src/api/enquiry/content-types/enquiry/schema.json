{
  "kind": "collectionType",
  "collectionName": "enquiries",
  "info": {
    "singularName": "enquiry",
    "pluralName": "enquiries",
    "displayName": "Enquiry"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "email": {
      "type": "email",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    },
    "consent": {
      "type": "boolean",
      "required": true
    },
    "receivedAt": {
      "type": "datetime"
    },
    "submissionStatus": {
      "type": "enumeration",
      "enum": [
        "new",
        "reviewing",
        "contacted",
        "closed"
      ],
      "default": "new"
    },
    "notes": {
      "type": "text"
    },
    "attachment": {
      "type": "customField",
      "customField": "global::submission-file"
    },
    "mode": {
      "type": "enumeration",
      "enum": [
        "india",
        "global"
      ],
      "default": "india"
    }
  }
}