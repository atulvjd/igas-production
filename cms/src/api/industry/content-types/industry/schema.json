{
  "kind": "collectionType",
  "collectionName": "industries",
  "info": {
    "singularName": "industry",
    "pluralName": "industries",
    "displayName": "Industry"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "shortDescription": { "type": "text" },
    "fullContent": { "type": "blocks" },
    "imageUrl": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "heroImage": { "type": "component", "repeatable": false, "component": "shared.media" },
    "relatedServices": { "type": "relation", "relation": "manyToMany", "target": "api::service.service" },
    "relatedArticles": { "type": "relation", "relation": "manyToMany", "target": "api::article.article" },
    "mode": { "type": "enumeration", "enum": ["india", "global"], "default": "india" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
