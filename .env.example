# Server-only Strapi connection used by Next.js
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDIA_SITE_URL=
NEXT_PUBLIC_GLOBAL_SITE_URL=

# Deployment-only, server-side safeguard. Set true only on the approved production deployment.
ALLOW_INDEXING=false

# Legacy contact delivery fallback when Strapi inbox storage is unconfigured.
CONTACT_DELIVERY_MODE=development
CONTACT_WEBHOOK_URL=

# Server-only newsletter delivery. Use development mode locally until a provider webhook is configured.
NEWSLETTER_DELIVERY_MODE=development
NEWSLETTER_WEBHOOK_URL=

# Server-only: protect the Strapi webhook -> Next.js cache invalidation endpoint.
REVALIDATION_SECRET=

# Server-only: generic contact webhooks only deliver attachment bytes when explicitly approved.
# Supported value: webhook-base64. Leave blank to reject production attachments safely.
CONTACT_ATTACHMENT_DELIVERY_MODE=

# Legacy recruitment fallback when Strapi inbox storage is unconfigured.
APPLICATION_WEBHOOK_URL=
APPLICATION_DELIVERY_MODE=development
APPLICATION_ATTACHMENT_DELIVERY_MODE=

# Server-only shared write credential, identical in Next.js and cms/.env (32+ random characters).
# When configured, both forms save to private Strapi inboxes instead of webhook/email delivery.
STRAPI_SUBMISSIONS_SECRET=
